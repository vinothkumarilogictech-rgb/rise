APP_ENV=development
DATABASE_URL=sqlite:///./rise.db
# Neon PostgreSQL production example:
# DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
GROK_API_KEY=your_grok_or_groq_api_key_here
GROK_MODEL=openai/gpt-oss-120b
JWT_SECRET_KEY=rise_super_secret_jwt_key_change_in_production_1234567890
ACCESS_TOKEN_EXPIRE_MINUTES=43200
CORS_ORIGINS=http://localhost:51219,http://127.0.0.1:51219,http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080
FCM_ENABLED=true
FIREBASE_PROJECT_ID=your-firebase-project-id
# Path to service-account JSON (e.g. local ./rise-firebase-adminsdk.json or Render Secret File /etc/secrets/rise-firebase-adminsdk.json):
FIREBASE_SERVICE_ACCOUNT_PATH=./rise-firebase-adminsdk.json
# Alternatively, provide raw JSON string for serverless/container deployment:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

